# Direct backend URL (no prefix). Restart/rebuild Vite after changing this.
VITE_API_BASE_URL=http://localhost:3010

# Socket.IO URL, including the events namespace. For Nginx deployment use:
# VITE_API_BASE_URL=https://spin-n-win.mobios.lk/api/v1/
# VITE_SOCKET_URL=https://spin-n-win.mobios.lk/api/v1/events
# The client uses namespace /events and transport path /api/v1/socket.io.
VITE_SOCKET_URL=http://localhost:3010/events
